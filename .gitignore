# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments (rebuild with setup_mac.sh) ─────────────────────────
.venv/
venv/
env/
node_modules/

# ── Runtime data — never commit (user papers, indexes, notes, DBs) ───────────
.data/
/Papers/
/SESSION_HANDOFF.md
/docs/review-data/
/docs/INITIAL_ASSESSMENT.md
/docs/RETRIEVAL_GPU_REVIEW.md
Local_Rag/papers/*
!Local_Rag/papers/.gitkeep
Local_Rag/output/*
!Local_Rag/output/.gitkeep
Local_Rag/rag/data/*
!Local_Rag/rag/data/.gitkeep
Local_Rag/rag/notes/*
!Local_Rag/rag/notes/.gitkeep
Local_Rag/rag/manuscripts/*
!Local_Rag/rag/manuscripts/.gitkeep
Local_Rag/rag/logs/*
!Local_Rag/rag/logs/.gitkeep

# Databases / vectors / model weights / backups anywhere
*.db
*.sqlite
*.sqlite-*
*.db-*
*.sqlite3
*.sqlite3-*
*.pre_*
*.bak
*.bak_*
*.gguf
*.pt
*.bin
*.safetensors
*.onnx
*.pth

# Local configuration and credentials; publish examples only.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env
*.pem
*.key
*.log

# Python installation uses the shared root requirements through setup.sh.
# Do not keep a second, independently resolved component lockfile.
/submission_strategy/uv.lock

# ── Caches ───────────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
._*
*.swp
.idea/
.vscode/
