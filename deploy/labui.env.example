# Copy to ~/.config/labui/labui.env, then set paths/server/model for this PC.
# This file is read by Bash and systemd EnvironmentFile. Do not use `export`.
LABUI_LLM_BACKEND=lmstudio
LM_STUDIO_URL=http://localhost:1234/v1
LABUI_HOST=127.0.0.1
LABUI_PORT=8770
LABUI_LM_PROXY_PORT=11435
# LABUI_DATA_DIR=/absolute/path/to/existing/library
# LM_STUDIO_MODEL=exact-model-id
# LABUI_ACCESS_POLICY=/absolute/path/to/private/access.json
# Keep the embedder and dimension consistent with your existing vector index.
# RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_EMBED_DIM=384
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Remote retrieval (migrate existing paper and memory vectors before enabling):
# RAG_EMBED_PROVIDER=lmstudio
# RAG_EMBED_BASE_URL=http://gpu-host:1234/v1
# RAG_EMBED_MODEL=text-embedding-qwen3-embedding-4b
# RAG_EMBED_DIM=2560
# RAG_EMBED_REVISION=Q8_0
# RAG_RERANK_PROVIDER=lmstudio
# RAG_RERANK_BASE_URL=http://gpu-host:1234/v1
# RAG_RERANKER_MODEL=qwen3-reranker-4b
# RAG_EMBED_MIGRATION_STATUS=/absolute/path/to/migration/status.json
JFR_CORPUS_AUTOSTART=0
JFR_CORPUS_REFRESH_DAYS=0
# Weekly nanobubble publication scout; manual scans remain available if paused.
LABUI_SCOUT_ENABLED=1
OMP_NUM_THREADS=2
